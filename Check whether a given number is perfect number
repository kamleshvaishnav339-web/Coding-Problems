#include<iostream>
using namespace std;
int main(){
    int number,i,sum=0;
    cout<<"Enter the number:";
    cin>>number;
    for(i=1;i<=number/2;i++){
        if(number%i==0){
                sum=sum+i;
        }
    }
    if(sum==number){
        cout<<number<<" is a parfect number";
    }
    else
        cout<<number<<" is not a parfect number";
    return 0;
}
