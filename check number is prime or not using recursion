#include<iostream>
using namespace std;
bool isprime(int a,int i){
    if(a==0){
        return 0;
    }
    if(a==1){
        return 1;
    }
    else{
        if(a%i==0){
            return 0;
        }
        else{
            return isprime(a,i-1);
        }
    }
}
int main(){
    int number,check;
    cout<<"Enter the number:";
    cin>>number;
    check=isprime(number,number/2);
    if(check==1){
        cout<<number<<" is a prime number";
    }
    else{
        cout<<number<<" is not a prime number";
    }
    return 0;
}
