#include <iostream>
using namespace std;

int isprime(int a) {
    if (a <= 1) {
        return 0;
    }

    for (int j = 2; j <= a / 2; j++) {
        if (a % j == 0) {
            return 0;   // Not prime
        }
    }

    return 1;   // Prime
}

int main() {
    int num1, num2;

    cout << "Enter the start of range: ";
    cin >> num1;

    cout << "Enter the end of range: ";
    cin >> num2;

    cout << "Prime numbers: ";

    for (int i = num1; i <= num2; i++) {
        if (isprime(i)) {
            cout << i << " ";
        }
    }

    return 0;
}
