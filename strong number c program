#include<iostream>
using namespace std;
int main(){
    int number,i,sum,strongsum=0,a,digit;
    cout<<"Enter the number:";
    cin>>number;
    a=number;
    while(number>0){
        digit=number%10;
        sum=1;
        for(i=1;i<=digit;i++){
            sum=sum*i;
        }
        strongsum=strongsum+sum;
        number=number/10;
    }
    if(a==0){
    cout<<"not a strong number";
    return 0;
    }
    if(a==strongsum)
        cout<<a<<" is a strong number";
    else
        cout<<a<<" is not a strong number";   
    return 0; 
}
